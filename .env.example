# Copy to ".env" in this directory — docker compose loads it automatically.
# mkdir -p data/ocr-cache data/ocr-debug
# Postgres files live in a Docker volume (postgres_data), not under ./data/postgres.
# If OCR cannot write cache or debug files: sudo chown -R 1000:1000 data/ocr-cache data/ocr-debug
#
# Apply DB migrations (after postgres is up): docker compose --profile migrate run --rm migrate

# --- Published host ports (web UI and API; map reverse-proxy here) ---
WEB_PORT=35466
API_PORT=35467

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=profittracker

# --- API (public URL must match how browsers reach the API; include /v1) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CORS_ORIGIN=https://dfstash.bzr.lt
VITE_API_URL=https://dfstashapi.bzr.lt/v1
