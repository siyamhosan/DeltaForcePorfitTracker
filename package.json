{
  "name": "vite-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "compose:migrate": "docker compose --profile migrate run --rm migrate",
    "compose:dev:migrate": "docker compose -f docker-compose.dev.yml --profile migrate run --rm migrate",
    "compose:dev": "docker compose -f docker-compose.dev.yml up --build",
    "compose:dev:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@clerk/backend": "^3.2.12",
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/themes": "^2.4.57",
    "react-router-dom": "^7.14.1"
  }
}
